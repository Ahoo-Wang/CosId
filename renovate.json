{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "commitMessageTopic": "{{depName}}",
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": { "enabled": false },
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group Spring ecosystem updates into a single PR",
      "matchPackageNames": ["/^org\\.springframework/"],
      "groupName": "spring"
    },
    {
      "description": "Activiti early-access builds (e.g. 7-201802-EA) predate the 7.0.0 releases but sort above them",
      "matchPackageNames": ["/^org\\.activiti:/"],
      "allowedVersions": "!/-EA$/i"
    },
    {
      "description": "Group Kotlin-related updates into a single PR",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin/"],
      "groupName": "kotlin"
    }
  ]
}
