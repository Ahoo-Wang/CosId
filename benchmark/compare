"""Compares two JMH JSON results by the rules of docs/architecture/10-performance-and-parity.md §1.3.

    benchmark/compare BASELINE.json CANDIDATE.json [--smoke] [--report REPORT.md]

BASELINE is the 4.x run (benchmark/baseline-4x), CANDIDATE the 5.x run (benchmark/v5) of the same scenarios on the same
machine. Rows are matched by benchmark (class.method), mode, threads and params. Prints a Markdown report and exits 1
when any row fails, 2 on bad input.

Release rules (default):
  throughput (thrpt)        score_5 >= score_4 - error_4
  latency (sample)          p99 and p99.9 of 5.x <= those of 4.x + error_4 (JMH gives no per-percentile error, so
                            error_4 is the error of the 4.x mean)
  average / single shot     score_5 <= score_4 + error_4; a single shot (startup) is at most 105% of 4.x
  allocation                gc.alloc.rate.norm of 5.x <= that of 4.x + its error, or <= 0.01 B/op (the
                            amortized cost of refills and other rare bookkeeping, not a hot path allocation);
                            the long hot paths (--zero-alloc) allocate nothing (< 1 B/op)
--smoke (PR smoke runs): throughput >= 0.9 x 4.x, latency and time <= 4.x / 0.9, allocation as above.
A row of the baseline missing from the candidate fails; rows only in the candidate are listed, not judged.
"""

import argparse
import json
import math
import re
import sys

ALLOC = "gc.alloc.rate.norm"
PREFIX = "me.ahoo.cosid.benchmark."
DEFAULT_ZERO_ALLOC = r"^(SnowflakeMillisBenchmark|SnowflakeSecondsBenchmark|SegmentBenchmark)\.generate_"
SMOKE_RATIO = 0.9
STARTUP_RATIO = 1.05
ZERO_ALLOC_BYTES = 1.0
ALLOC_FLOOR_BYTES = 0.01


def error(metric):
    value = metric.get("scoreError", 0.0)
    return 0.0 if value is None or (isinstance(value, float) and math.isnan(value)) or value == "NaN" else float(value)


def key(row):
    params = ",".join(f"{k}={v}" for k, v in sorted((row.get("params") or {}).items()))
    return (row["benchmark"].removeprefix(PREFIX), row["mode"], row["threads"], params)


def load(path):
    with open(path, encoding="utf-8") as file:
        rows = json.load(file)
    if not isinstance(rows, list):
        raise ValueError(f"{path}: not a JMH JSON result (expected a list)")
    return {key(row): row for row in rows}


def fmt(value):
    return f"{value:,.3f}" if abs(value) < 1000 else f"{value:,.0f}"


def judge(base, cand, smoke, zero_alloc):
    """Returns [(metric, baseline, candidate, limit, passed)] for one row."""
    checks = []
    b, c = base["primaryMetric"], cand["primaryMetric"]
    mode = base["mode"]
    unit = b.get("scoreUnit", "")
    if mode == "thrpt":
        limit = b["score"] * SMOKE_RATIO if smoke else b["score"] - error(b)
        checks.append((f"score ({unit})", b["score"], c["score"], f">= {fmt(limit)}", c["score"] >= limit))
    elif mode == "sample":
        for percentile in ("99.0", "99.9"):
            bp = b.get("scorePercentiles", {}).get(percentile)
            cp = c.get("scorePercentiles", {}).get(percentile)
            if bp is None or cp is None:
                checks.append((f"p{percentile}", bp or 0.0, cp or 0.0, "present", False))
                continue
            limit = bp / SMOKE_RATIO if smoke else bp + error(b)
            checks.append((f"p{percentile} ({unit})", bp, cp, f"<= {fmt(limit)}", cp <= limit))
    elif mode == "ss":
        limit = b["score"] / SMOKE_RATIO if smoke else b["score"] * STARTUP_RATIO
        checks.append((f"time ({unit})", b["score"], c["score"], f"<= {fmt(limit)}", c["score"] <= limit))
    else:  # avgt
        limit = b["score"] / SMOKE_RATIO if smoke else b["score"] + error(b)
        checks.append((f"score ({unit})", b["score"], c["score"], f"<= {fmt(limit)}", c["score"] <= limit))
    ba = base.get("secondaryMetrics", {}).get(ALLOC)
    ca = cand.get("secondaryMetrics", {}).get(ALLOC)
    if ba is not None and ca is not None:
        name = key(base)[0]
        if mode == "thrpt" and zero_alloc.search(name):
            checks.append(("alloc (B/op)", ba["score"], ca["score"], f"< {ZERO_ALLOC_BYTES}", ca["score"] < ZERO_ALLOC_BYTES))
        else:
            limit = max(ba["score"] + error(ba), ALLOC_FLOOR_BYTES)
            checks.append(("alloc (B/op)", ba["score"], ca["score"], f"<= {fmt(limit)}", ca["score"] <= limit))
    return checks


def compare(baseline, candidate, smoke=False, zero_alloc=DEFAULT_ZERO_ALLOC):
    """Returns (report lines, number of failed rows)."""
    pattern = re.compile(zero_alloc)
    lines = [
        f"# Benchmark comparison ({'smoke' if smoke else 'release'} rules)",
        "",
        "| Benchmark | Mode | Threads | Params | Metric | 4.x | 5.x | Limit | Result |",
        "|---|---|---|---|---|---|---|---|---|",
    ]
    failed = 0
    for row_key in sorted(baseline):
        name, mode, threads, params = row_key
        cand = candidate.get(row_key)
        if cand is None:
            lines.append(f"| {name} | {mode} | {threads} | {params} | - | - | missing | - | FAIL |")
            failed += 1
            continue
        row_failed = False
        for metric, b, c, limit, passed in judge(baseline[row_key], cand, smoke, pattern):
            row_failed |= not passed
            lines.append(f"| {name} | {mode} | {threads} | {params} | {metric} | {fmt(b)} | {fmt(c)} | {limit} | "
                         f"{'PASS' if passed else 'FAIL'} |")
        failed += row_failed
    extra = sorted(set(candidate) - set(baseline))
    if extra:
        lines += ["", "Only in 5.x (not judged): " + ", ".join(f"{k[0]} ({k[1]}, {k[2]} threads)" for k in extra)]
    lines += ["", f"**{'FAIL' if failed else 'PASS'}**: {failed} of {len(baseline)} baseline rows failed."]
    return lines, failed


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("baseline", help="the 4.x JMH JSON result")
    parser.add_argument("candidate", help="the 5.x JMH JSON result")
    parser.add_argument("--smoke", action="store_true", help="the looser PR smoke rules")
    parser.add_argument("--zero-alloc", default=DEFAULT_ZERO_ALLOC,
                        help="regex of class.method whose throughput rows must allocate nothing")
    parser.add_argument("--report", help="also write the report to this file")
    args = parser.parse_args(argv)
    try:
        lines, failed = compare(load(args.baseline), load(args.candidate), args.smoke, args.zero_alloc)
    except (OSError, ValueError, KeyError) as problem:
        print(f"compare: {problem}", file=sys.stderr)
        return 2
    report = "\n".join(lines) + "\n"
    print(report, end="")
    if args.report:
        with open(args.report, "w", encoding="utf-8") as file:
            file.write(report)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
