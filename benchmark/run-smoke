#
# Runs scenarios on benchmark/baseline-4x and benchmark/v5 back to back, interleaved per scenario (4.x then 5.x for
# each), then judges the two results with `compare --smoke` (10-performance-and-parity.md §1.3). Both sides run in
# the same invocation on the same machine, so the result does not depend on stored numbers.
#
#   benchmark/run-smoke [--release] [--out DIR] [--max-load N] [SCENARIO...]
#
# SCENARIO is P1..P12 (P7 and P10 stand for their store classes, see benchmark/scenarios.md) or a class name such as
# SegmentBenchmark; the default is the PR smoke set P1 P3 P5 P9. --release uses the release-gate JMH settings and
# release compare rules instead of the smoke ones. A store scenario (P7, P10: the MySql*, Redis*, Mongo* and Zookeeper*
# classes) runs each side twice in ABBA order, 4.x 5.x 5.x 4.x, with half the forks each (rounded up), so that neither
# side always runs right after the other on the store (benchmark/merge-results joins the two runs of a side).
# --max-load aborts (status 3) when the 1-minute load average is above N before a scenario. Results land in DIR
# (default build/benchmark-smoke): the JSON of each side, the run logs, load.tsv and report.md. Exits with the status
# of compare (0 PASS, 1 FAIL, 2 bad input, 4 harness error: a side without its rows or a JMH <failure> in a log, which
# is no result).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/build/benchmark-smoke"
profile=smoke
max_load=
scenarios=()
while (($#)); do
    case "$1" in
        --release) profile=release ;;
        --out) out="$2"; shift ;;
        --max-load) max_load="$2"; shift ;;
        -h|--help) sed -n '14,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) scenarios+=("$1") ;;
    esac
    shift
done
((${#scenarios[@]})) || scenarios=(P1 P3 P5 P9)

class_of() {
    case "$1" in
        P1) echo SnowflakeMillisBenchmark ;;
        P2) echo SnowflakeSecondsBenchmark ;;
        P3) echo SnowflakeStringBenchmark ;;
        P4) echo CosId80Benchmark ;;
        P5) echo SegmentBenchmark AtomicLongBenchmark ;;
        P6) echo SegmentNoPrefetchBenchmark ;;
        P8) echo PeriodicSegmentBenchmark ;;
        P9) echo CodecBenchmark ;;
        P7) echo MySqlChainIdBenchmark RedisChainIdBenchmark MongoChainIdBenchmark ZookeeperChainIdBenchmark ;;
        P10) echo MySqlStoreBenchmark RedisStoreBenchmark MongoStoreBenchmark ZookeeperStoreBenchmark ;;
        P11) echo SpringStartBenchmark ;;
        P12) echo IdFillerBenchmark ;;
        P*) echo "run-smoke: unknown scenario $1" >&2; return 1 ;;
        *) echo "$1" ;;
    esac
}

if [[ $profile == smoke ]]; then
    jmh_args=(-f 1 -wi 2 -w 1s -i 3 -r 1s)
    compare_args=(--smoke)
else
    jmh_args=(-f 3 -wi 5 -w 2s -i 5 -r 2s)
    compare_args=()
fi
# Each of the two runs of a side in ABBA order: half the forks, rounded up.
abba_args=("${jmh_args[@]}")
for i in "${!abba_args[@]}"; do
    [[ ${abba_args[$i]} == -f ]] && abba_args[$((i + 1))]=$(((${abba_args[$((i + 1))]} + 1) / 2))
done

# The store scenarios, which run ABBA.
is_store() {
    [[ $1 =~ ^(MySql|Redis|Mongo|Zookeeper) ]]
}

# Reference classes exist on 5.x only: run there, right after their scenario, never compared (compare, REFERENCE).
references=(AtomicLongBenchmark)
is_reference() {
    local reference
    for reference in "${references[@]}"; do
        [[ $1 == "$reference" ]] && return 0
    done
    return 1
}

classes=()
for scenario in "${scenarios[@]}"; do
    names="$(class_of "$scenario")"
    read -r -a names <<<"$names"
    classes+=("${names[@]}")
done

cd "$root"
./gradlew -q :benchmark:baseline-4x:checkJmhJar :benchmark:v5:checkJmhJar \
    || { echo "run-smoke: harness error: the JMH jars did not build or failed checkJmhJar" >&2; exit 4; }
java="$(./gradlew -q :benchmark:v5:printJmhJava | tail -n 1)"
mkdir -p "$out"
rm -f "$out"/*.json "$out"/*.log "$out"/report.md "$out"/load.tsv

# The 1-minute load average.
load1() {
    if [[ -r /proc/loadavg ]]; then cut -d' ' -f1 /proc/loadavg; else sysctl -n vm.loadavg | awk '{print $2}'; fi
}

# Runs one side; waits for another JMH run on the machine (JMH's machine-wide lock) rather than overlapping it.
# run SIDE CLASS [PART]: PART (a, b) is one of the two runs of an ABBA scenario, on half the forks.
run() {
    local side="$1" class="$2" part="${3:-}" jar log name args
    jar="$(ls "$root/benchmark/$side/build/libs/"*-jmh.jar)"
    name="$side-$class${part:+.$part}"
    log="$out/$name.log"
    args=("${jmh_args[@]}")
    [[ -n $part ]] && args=("${abba_args[@]}")
    for _ in $(seq 1 40); do
        if "$java" -jar "$jar" "^me\.ahoo\.cosid\.benchmark\.$class\." "${args[@]}" -prof gc \
            -rf json -rff "$out/$name.json" -jvmArgs "-Dlogback.configurationFile=$root/config/logback-jmh.xml" \
            >"$log" 2>&1; then
            return 0
        fi
        grep -q "Unable to acquire the JMH lock" "$log" || break
        echo "run-smoke: another JMH run holds the lock; waiting" >&2
        sleep 30
    done
    # A failing scenario leaves its rows out: compare reports a harness error, with the exception from this log.
    echo "run-smoke: $side $class${part:+ ($part)} failed, see $log" >&2
    [[ -s "$out/$name.json" ]] || echo "[]" >"$out/$name.json"
}

for class in "${classes[@]}"; do
    load="$(load1)"
    printf '%s\t%s\n' "$class" "$load" >>"$out/load.tsv"
    if [[ -n $max_load ]] && awk -v load="$load" -v max="$max_load" 'BEGIN { exit !(load > max) }'; then
        echo "run-smoke: the 1-minute load average is $load, above $max_load, before $class: aborting" >&2
        exit 3
    fi
    if is_reference "$class"; then
        echo "run-smoke: $class (reference) on 5.x (load $load)" >&2
        run v5 "$class"
        continue
    fi
    if is_store "$class"; then
        echo "run-smoke: $class on 4.x, 5.x, 5.x, 4.x (ABBA, load $load)" >&2
        run baseline-4x "$class" a
        run v5 "$class" a
        run v5 "$class" b
        run baseline-4x "$class" b
        continue
    fi
    echo "run-smoke: $class on 4.x, then 5.x (load $load)" >&2
    run baseline-4x "$class"
    run v5 "$class"
done

# One result per side; the two runs of an ABBA scenario become one row each (benchmark/merge-results).
merge() {
    "$root/benchmark/merge-results" "$out/$1.json.tmp" "$out/$1"-*.json
    mv "$out/$1.json.tmp" "$out/$1.all.json"
}
merge baseline-4x
merge v5

status=0
"$root/benchmark/compare" "$out/baseline-4x.all.json" "$out/v5.all.json" "${compare_args[@]}" --logs "$out" \
    --report "$out/report.md" || status=$?
echo "run-smoke: report in $out/report.md" >&2
exit "$status"
