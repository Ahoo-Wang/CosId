"""Compares two JMH JSON results by the rules of docs/architecture/10-performance-and-parity.md §1.3.

    benchmark/compare BASELINE.json CANDIDATE.json [--smoke] [--report REPORT.md]

BASELINE is the 4.x run (benchmark/baseline-4x), CANDIDATE the 5.x run (benchmark/v5) of the same scenarios on the same
machine. Rows are matched by benchmark (class.method), mode, threads and params. A candidate score in another unit than
its baseline (ops/ms against ops/us, ns/op against us/op) is converted to the baseline's unit before it is judged; units
that do not convert (a throughput against a time) are bad input. Prints a Markdown report and exits 1 when any row
fails, 2 on bad input, 4 on a harness error.

Release rules (default, D34): a row's limit is the more lenient of 4.x with its JMH error and 4.x with a tolerance.
  throughput (thrpt)        score_5 >= min(score_4 - error_4, score_4 x 0.95)
  latency (sample)          p99 and p99.9 of 5.x <= max(those of 4.x + error_4, those of 4.x x 1.10, those of 4.x +
                            100 ns) (JMH gives no per-percentile error, so error_4 is the error of the 4.x mean; D50:
                            a tail of tens of nanoseconds moves by the timer's resolution and the runner's noise alone)
  average / single shot     score_5 <= max(score_4 + error_4, score_4 x 1.05); a startup scenario (--startup, P11 by
                            default) is at most 105% of 4.x
  allocation                gc.alloc.rate.norm of 5.x <= max(4.x + its error, 4.x x 1.05, 4.x + 64 B), and always
                            passes at <= 0.01 B/op (the amortized cost of refills and other rare bookkeeping, not a hot
                            path allocation); the long hot paths (--zero-alloc) allocate nothing (< 1 B/op)
Row kinds (D44, the SCENARIOS table below): the gate is end-to-end ID generation. End-to-end rows (P1-P8, P11, P12)
are judged by the rules above, failing past them. Component rows (P9 codecs, P10 store primitives) pass within the
rules above, WARN up to throughput 0.80 x / average time 1.20 x / p99 and p99.9 max(1.30 x, +100 ns) / allocation
max(1.25 x, +64 B) of 4.x (each also allowing 4.x's error), and fail beyond. Only failed rows re-run and fail the comparison; WARN rows get
a section of their own, and the summary reads PASS (n WARN). A class not in the table is judged as end-to-end.
Reference rows (5.x only, such as AtomicLongBenchmark for P5) are never judged: a section of their own reports each and
the scenario it bounds, 4.x and 5.x, as a share of it at the same threads. Trend rows (5.x only, with no 4.x counterpart,
such as UuidV7Benchmark, P13) are never judged either: a section of their own reports their scores.
--smoke (PR smoke runs): throughput >= 0.9 x 4.x, latency and time <= 4.x / 0.9, allocation as above; no WARN.
Harness errors (exit 4) are not results: a row on one side only (or missing from a re-run) - only the reference and
trend classes run on 5.x alone -, no row at all on either side, and, with --logs DIR, a JMH <failure> in any DIR/*.log
(a benchmark that threw, such as a setup that found no store) or a DIR/*.failed (a JMH run that exited with a non-zero
status, written by benchmark/run-smoke and run-release beside the run's log). The report lists them with the first
lines of each exception; such a row is neither judged nor re-run, and the comparison fails whatever the other rows
did.

--failed FILE writes the rows that failed as JSON (benchmark, mode, threads, params), for a re-run. --rerun BASELINE2
CANDIDATE2 judges those rows again on a re-run of both sides in fresh forks (the release gate on shared CI runners):
a row that failed passes only if its re-run passes, and the report keeps both.
"""

import argparse
import json
import math
import os
import re
import sys

ALLOC = "gc.alloc.rate.norm"
PREFIX = "me.ahoo.cosid.benchmark."
DEFAULT_ZERO_ALLOC = r"^(SnowflakeMillisBenchmark|SnowflakeSecondsBenchmark|SegmentBenchmark)\.generate_"
DEFAULT_STARTUP = r"^SpringStartBenchmark\."
SMOKE_RATIO = 0.9
STARTUP_RATIO = 1.05
ZERO_ALLOC_BYTES = 1.0
ALLOC_FLOOR_BYTES = 0.01
# D34: the tolerances of the release rules, beside the 4.x JMH error (which alone is below a shared runner's noise).
THROUGHPUT_TOLERANCE = 0.05
TIME_TOLERANCE = 0.05
PERCENTILE_TOLERANCE = 0.10
# D50: an absolute floor of the p99 / p99.9 limits, beside the tolerance: below a microsecond a tail moves by the timer's
# resolution and the runner's noise more than by 10%.
PERCENTILE_FLOOR_NANOS = 100.0
# Nanoseconds per time unit of a JMH score (JMH writes ns, us, ms, s, min, hr and day).
NANOS = {"ns": 1.0, "us": 1e3, "\u00b5s": 1e3, "ms": 1e6, "s": 1e9, "min": 60e9, "hr": 3600e9, "day": 86400e9}
ALLOC_TOLERANCE = 0.05
ALLOC_SLACK_BYTES = 64.0
# D44: how far a component row may fall behind 4.x and only WARN.
WARN_THROUGHPUT_TOLERANCE = 0.20
WARN_TIME_TOLERANCE = 0.20
WARN_PERCENTILE_TOLERANCE = 0.30
WARN_ALLOC_TOLERANCE = 0.25
END_TO_END = "end-to-end"
COMPONENT = "component"
REFERENCE = "reference"
TREND = "trend"
# D44: every benchmark class of benchmark/scenarios.md, its scenario and whether it measures ID generation end to end
# or one component of it. Kept in this one place for review; a class missing here is judged as end-to-end.
SCENARIOS = {
    "SnowflakeMillisBenchmark": ("P1", END_TO_END),
    "SnowflakeSecondsBenchmark": ("P2", END_TO_END),
    "SnowflakeStringBenchmark": ("P3", END_TO_END),
    "CosId80Benchmark": ("P4", END_TO_END),
    "SegmentBenchmark": ("P5", END_TO_END),
    "AtomicLongBenchmark": ("P5", REFERENCE),
    "UuidV7Benchmark": ("P13", TREND),
    "SegmentNoPrefetchBenchmark": ("P6", END_TO_END),
    "MySqlChainIdBenchmark": ("P7", END_TO_END),
    "RedisChainIdBenchmark": ("P7", END_TO_END),
    "MongoChainIdBenchmark": ("P7", END_TO_END),
    "ZookeeperChainIdBenchmark": ("P7", END_TO_END),
    "PeriodicSegmentBenchmark": ("P8", END_TO_END),
    "CodecBenchmark": ("P9", COMPONENT),
    "MySqlStoreBenchmark": ("P10", COMPONENT),
    "RedisStoreBenchmark": ("P10", COMPONENT),
    "MongoStoreBenchmark": ("P10", COMPONENT),
    "ZookeeperStoreBenchmark": ("P10", COMPONENT),
    "SpringStartBenchmark": ("P11", END_TO_END),
    "IdFillerBenchmark": ("P12", END_TO_END),
}
# A reference class (5.x only, never judged) and the scenario class whose throughput is reported as a share of it.
REFERENCE_OF = {"AtomicLongBenchmark": "SegmentBenchmark"}
PASS, WARN, FAIL = "PASS", "WARN", "FAIL"
HARNESS = "HARNESS ERROR"
# The lines of a JMH <failure> shown in the report: the exception and where it was thrown.
FAILURE_LINES = 8


def failures(logs):
    """[(log file name, excerpt)] of the directory logs: the first lines after each JMH <failure> of a *.log, and for each
    *.failed (a JMH run that exited with a non-zero status: benchmark/run-smoke writes the status there) its text and the
    last lines of the run's log, which hold the reason (a JVM that did not start prints no <failure>)."""
    found = []
    for name in sorted(os.listdir(logs)):
        if name.endswith(".failed"):
            log = name.removesuffix(".failed") + ".log"
            with open(os.path.join(logs, name), encoding="utf-8", errors="replace") as file:
                excerpt = [text for text in file.read().splitlines() if text.strip()]
            if os.path.exists(os.path.join(logs, log)):
                with open(os.path.join(logs, log), encoding="utf-8", errors="replace") as file:
                    excerpt += [text for text in file.read().splitlines() if text.strip()][-FAILURE_LINES:]
            found.append((log, excerpt))
            continue
        if not name.endswith(".log"):
            continue
        with open(os.path.join(logs, name), encoding="utf-8", errors="replace") as file:
            lines = file.read().splitlines()
        for at, line in enumerate(lines):
            if line.strip() == "<failure>":
                excerpt = [text for text in lines[at + 1:] if text.strip()][:FAILURE_LINES]
                found.append((name, excerpt))
    return found


def factor(source, target):
    """The factor that turns a score in the unit source into the unit target (ops/ms into ops/us: 0.001, us/op into
    ns/op: 1000); raises ValueError when they do not convert (a throughput against a time, or an unknown unit)."""
    source, target = source.strip(), target.strip()
    if source == target:
        return 1.0
    s, t = source.split("/"), target.split("/")
    if len(s) == 2 and len(t) == 2:
        if s[0] == t[0] == "ops" and s[1] in NANOS and t[1] in NANOS:  # operations per time
            return NANOS[t[1]] / NANOS[s[1]]
        if s[1] == t[1] == "op" and s[0] in NANOS and t[0] in NANOS:  # time per operation
            return NANOS[s[0]] / NANOS[t[0]]
    raise ValueError(f"a score in {source or 'no unit'} does not convert to {target or 'no unit'}")


def in_unit(metric, unit):
    """metric (a JMH primary or secondary metric) with its score, error and percentiles in unit: a copy when its own
    unit differs, the metric itself otherwise. A metric without a unit is taken to be in unit."""
    own = metric.get("scoreUnit", unit)
    if own == unit:
        return metric
    scale = factor(own, unit)
    converted = {**metric, "score": metric["score"] * scale, "scoreUnit": unit}
    if "scoreError" in metric:
        converted["scoreError"] = error(metric) * scale
    if "scorePercentiles" in metric:
        converted["scorePercentiles"] = {p: v * scale for p, v in metric["scorePercentiles"].items()}
    return converted


def in_units_of(base, cand):
    """cand with each metric in the unit of the same metric of base, so that the two compare as numbers (#1442)."""
    primary = in_unit(cand["primaryMetric"], base["primaryMetric"].get("scoreUnit", ""))
    secondary = dict(cand.get("secondaryMetrics") or {})
    for name, metric in secondary.items():
        theirs = (base.get("secondaryMetrics") or {}).get(name)
        if theirs is not None and "scoreUnit" in theirs:
            secondary[name] = in_unit(metric, theirs["scoreUnit"]) if name != ALLOC else same_unit(metric, theirs)
    return {**cand, "primaryMetric": primary, "secondaryMetrics": secondary}


def same_unit(metric, theirs):
    """metric when it is in the unit of theirs (bytes per operation has no other unit); ValueError otherwise."""
    if metric.get("scoreUnit", theirs["scoreUnit"]) != theirs["scoreUnit"]:
        raise ValueError(f"{ALLOC} in {metric['scoreUnit']} does not compare with {theirs['scoreUnit']}")
    return metric


def error(metric):
    value = metric.get("scoreError", 0.0)
    return 0.0 if value is None or (isinstance(value, float) and math.isnan(value)) or value == "NaN" else float(value)


def key(row):
    params = ",".join(f"{k}={v}" for k, v in sorted((row.get("params") or {}).items()))
    return (row["benchmark"].removeprefix(PREFIX), row["mode"], row["threads"], params)


def load(path):
    with open(path, encoding="utf-8") as file:
        rows = json.load(file)
    if not isinstance(rows, list):
        raise ValueError(f"{path}: not a JMH JSON result (expected a list)")
    return {key(row): row for row in rows}


def fmt(value):
    return f"{value:,.3f}" if abs(value) < 1000 else f"{value:,.0f}"


def kind(name):
    """END_TO_END or COMPONENT, by the class of class.method (SCENARIOS); end-to-end when the class is not listed."""
    return SCENARIOS.get(name.split(".", 1)[0], (None, END_TO_END))[1]


def grade(value, limit, warn, at_least):
    """PASS within limit, WARN within warn (None: no WARN), FAIL beyond; at_least: higher values are better."""
    within = (lambda bound: value >= bound) if at_least else (lambda bound: value <= bound)
    if within(limit):
        return PASS
    return WARN if warn is not None and within(warn) else FAIL


def bound(limit, warn, at_least):
    sign = ">=" if at_least else "<="
    return f"{sign} {fmt(limit)}" + ("" if warn is None else f" (WARN {sign} {fmt(warn)})")


def percentile_floor(unit):
    """PERCENTILE_FLOOR_NANOS in a score unit such as us/op; 0 for a unit that is no time per operation."""
    nanos = NANOS.get(unit.split("/")[0].strip())
    return PERCENTILE_FLOOR_NANOS / nanos if nanos else 0.0


def judge(base, cand, smoke, zero_alloc, startup=re.compile(DEFAULT_STARTUP)):
    """Returns [(metric, baseline, candidate, limit, result)] for one row, result PASS, WARN or FAIL."""
    checks = []
    b, c = base["primaryMetric"], cand["primaryMetric"]
    mode = base["mode"]
    name = key(base)[0]
    unit = b.get("scoreUnit", "")
    soft = not smoke and kind(name) == COMPONENT
    if mode == "thrpt":
        limit = b["score"] * SMOKE_RATIO if smoke else min(b["score"] - error(b), b["score"] * (1 - THROUGHPUT_TOLERANCE))
        warn = min(b["score"] - error(b), b["score"] * (1 - WARN_THROUGHPUT_TOLERANCE)) if soft else None
        checks.append((f"score ({unit})", b["score"], c["score"], bound(limit, warn, True), grade(c["score"], limit, warn, True)))
    elif mode == "sample":
        for percentile in ("99.0", "99.9"):
            bp = b.get("scorePercentiles", {}).get(percentile)
            cp = c.get("scorePercentiles", {}).get(percentile)
            if bp is None or cp is None:
                checks.append((f"p{percentile}", bp or 0.0, cp or 0.0, "present", FAIL))
                continue
            floor = bp + percentile_floor(unit)
            limit = bp / SMOKE_RATIO if smoke else max(bp + error(b), bp * (1 + PERCENTILE_TOLERANCE), floor)
            warn = max(bp + error(b), bp * (1 + WARN_PERCENTILE_TOLERANCE), floor) if soft else None
            checks.append((f"p{percentile} ({unit})", bp, cp, bound(limit, warn, False), grade(cp, limit, warn, False)))
    elif startup.search(name):
        limit = b["score"] / SMOKE_RATIO if smoke else b["score"] * STARTUP_RATIO
        checks.append((f"time ({unit})", b["score"], c["score"], bound(limit, None, False), grade(c["score"], limit, None, False)))
    else:  # avgt, ss
        limit = b["score"] / SMOKE_RATIO if smoke else max(b["score"] + error(b), b["score"] * (1 + TIME_TOLERANCE))
        warn = max(b["score"] + error(b), b["score"] * (1 + WARN_TIME_TOLERANCE)) if soft else None
        checks.append((f"score ({unit})", b["score"], c["score"], bound(limit, warn, False), grade(c["score"], limit, warn, False)))
    ba = base.get("secondaryMetrics", {}).get(ALLOC)
    ca = cand.get("secondaryMetrics", {}).get(ALLOC)
    if ba is not None and ca is not None:
        if mode == "thrpt" and zero_alloc.search(name):
            checks.append(("alloc (B/op)", ba["score"], ca["score"], f"< {ZERO_ALLOC_BYTES}",
                           PASS if ca["score"] < ZERO_ALLOC_BYTES else FAIL))
        else:
            limit = max(ba["score"] + error(ba), ba["score"] * (1 + ALLOC_TOLERANCE), ba["score"] + ALLOC_SLACK_BYTES,
                        ALLOC_FLOOR_BYTES)
            warn = max(ba["score"] + error(ba), ba["score"] * (1 + WARN_ALLOC_TOLERANCE), ba["score"] + ALLOC_SLACK_BYTES,
                       ALLOC_FLOOR_BYTES) if soft else None
            checks.append(("alloc (B/op)", ba["score"], ca["score"], bound(limit, warn, False), grade(ca["score"], limit, warn, False)))
    return checks


def compare(baseline, candidate, smoke=False, zero_alloc=DEFAULT_ZERO_ALLOC, startup=DEFAULT_STARTUP, rerun=None,
            warned=None, harness=None, logs=()):
    """Returns (report lines, number of failed rows, their keys); rerun = (baseline, candidate) of the failed rows. The
    keys of the rows that ended as WARN are appended to warned, a list, when it is given; the keys of the missing rows
    to harness, likewise. logs is failures() of the run logs: any makes the comparison a harness error, as does a
    comparison without a row on either side (nothing ran: an empty comparison must never read as PASS)."""
    if not baseline and not candidate:
        logs = [*logs, ("(no results)", ["Neither side produced a row: nothing ran."])]
    pattern = re.compile(zero_alloc)
    startup_pattern = re.compile(startup)
    lines = [
        f"# Benchmark comparison ({'smoke' if smoke else 'release'} rules)",
        "",
        "| Benchmark | Mode | Threads | Params | Metric | 4.x | 5.x | Limit | Result |",
        "|---|---|---|---|---|---|---|---|---|",
    ]
    warnings, missing = [], []
    # Every row of a class that runs on both sides is expected on both: a 5.x row without its 4.x counterpart is a 4.x
    # run that broke (#1433), not a row to leave out. Only the reference and trend classes run on 5.x alone.
    expected = set(baseline) | {k for k in candidate if kind(k[0]) not in (REFERENCE, TREND)}
    failed = table(lines, baseline, candidate, sorted(expected), smoke, pattern, startup_pattern, warnings, missing)
    first = len(failed)
    if rerun is not None and failed:
        lines += ["", "## Re-run of the failed rows", "",
                  "Both sides again, in fresh forks; a row that failed above passes only if it passes here.", "",
                  "| Benchmark | Mode | Threads | Params | Metric | 4.x | 5.x | Limit | Result |",
                  "|---|---|---|---|---|---|---|---|---|"]
        # A re-run row is judged on its re-run alone, WARN included.
        rerun_warnings = []
        retried = failed
        failed = table(lines, rerun[0], rerun[1], failed, smoke, pattern, startup_pattern, rerun_warnings, missing)
        warnings = [w for w in warnings if w[0] not in retried] + rerun_warnings
    warnings = [w for w in warnings if w[0] not in failed]
    if warnings:
        lines += ["", "## WARN: component rows past D34, within the D44 limits", "",
                  "Not blocking (D44): the gate is end-to-end ID generation; these components fell behind 4.x by this much.", "",
                  "| Benchmark | Mode | Threads | Params | Metric | 4.x | 5.x | Change |", "|---|---|---|---|---|---|---|---|"]
        for (name, mode, threads, params), metric, b, c in warnings:
            change = f"{(c - b) / b:+.1%}" if b else "-"
            lines.append(f"| {name} | {mode} | {threads} | {params} | {metric} | {fmt(b)} | {fmt(c)} | {change} |")
    lines += reference(baseline, candidate)
    lines += trend(candidate)
    if warned is not None:
        warned += list(dict.fromkeys(w[0] for w in warnings))
    if missing or logs:
        lines += ["", f"## {HARNESS}: not a result", "",
                  "The benchmark harness broke, so these rows say nothing about performance: fix the harness and run again.", ""]
        lines += [f"- missing: {name} ({mode}, {threads} threads{', ' + params if params else ''})"
                  for name, mode, threads, params in missing]
        for name, excerpt in logs:
            lines += ["", f"`{name}`:", "", "```", *excerpt, "```"]
    if harness is not None:
        harness += missing
    verdict = (HARNESS if missing or logs else
               "FAIL" if failed else "PASS" + (f" ({len(set(w[0] for w in warnings))} WARN)" if warnings else ""))
    summary = f"**{verdict}**: {len(failed)} of {len(baseline)} baseline rows failed"
    if missing or logs:
        summary += f", {len(missing)} missing, {len(logs)} JMH failures in the logs"
    if rerun is not None and first:
        summary += f" ({first} failed the first run and were re-run)"
    lines += ["", summary + "."]
    return lines, len(failed), failed


def reference(baseline, candidate):
    """The reference rows of candidate (5.x only, never judged): each score, and the throughput of the scenario it
    bounds, 4.x and 5.x, as a share of it at the same threads (REFERENCE_OF)."""
    keys = sorted((k for k in candidate if kind(k[0]) == REFERENCE and k[1] == "thrpt"), key=lambda k: (k[0], k[2]))
    if not keys:
        return []
    lines = ["", "## Reference (not judged)", "",
             "The bound of a scenario on this runner, and each side of the scenario as a share of it at the same threads.", "",
             "| Reference | Threads | ops/µs | 4.x | 5.x |", "|---|---|---|---|---|"]
    for name, mode, threads, params in keys:
        metric = candidate[(name, mode, threads, params)]["primaryMetric"]
        score, unit = metric["score"], metric.get("scoreUnit", "")
        bounded = REFERENCE_OF[name.split(".", 1)[0]]
        cells = []
        for side in (baseline, candidate):
            scores = [(k, in_unit(r["primaryMetric"], unit)["score"])
                      for k, r in sorted(side.items()) if k[0].split(".", 1)[0] == bounded and k[1] == "thrpt" and k[2] == threads]
            shares = [f"{k[3] or '-'}: {fmt(value)} ({value / score:.0%})" for k, value in scores]
            cells.append(", ".join(shares) or "-")
        lines.append(f"| {name} | {threads} | {fmt(score)} | {cells[0]} | {cells[1]} |")
    return lines


def trend(candidate):
    """The trend rows of candidate (5.x only, without a 4.x counterpart, never judged): each score, by threads."""
    keys = sorted((k for k in candidate if kind(k[0]) == TREND), key=lambda k: (k[0], k[1], k[2], k[3]))
    if not keys:
        return []
    lines = ["", "## 5.x trend (not judged)", "",
             "5.x alone, with no 4.x counterpart: reported to follow its trend across runs, never compared.", "",
             "| Benchmark | Mode | Threads | Params | Score | Error | Unit |", "|---|---|---|---|---|---|---|"]
    for key in keys:
        name, mode, threads, params = key
        metric = candidate[key]["primaryMetric"]
        lines.append(f"| {name} | {mode} | {threads} | {params or '-'} | {fmt(metric['score'])} | {fmt(error(metric))} | {metric['scoreUnit']} |")
    return lines


def table(lines, baseline, candidate, keys, smoke, pattern, startup_pattern, warnings, missing):
    """Appends the rows of keys to lines; returns the keys of the rows that failed, appends
    (key, metric, baseline, candidate) of each WARN check to warnings and the key of each row missing a side to
    missing."""
    failed = []
    for row_key in keys:
        name, mode, threads, params = row_key
        base, cand = baseline.get(row_key), candidate.get(row_key)
        if base is None or cand is None:
            lines.append(f"| {name} | {mode} | {threads} | {params} | - | {'-' if base else 'missing'} | "
                         f"{'-' if cand else 'missing'} | - | {HARNESS} |")
            missing.append(row_key)
            continue
        row_failed = False
        for metric, b, c, limit, result in judge(base, in_units_of(base, cand), smoke, pattern, startup_pattern):
            row_failed |= result == FAIL
            if result == WARN:
                warnings.append((row_key, metric, b, c))
            lines.append(f"| {name} | {mode} | {threads} | {params} | {metric} | {fmt(b)} | {fmt(c)} | {limit} | {result} |")
        if row_failed:
            failed.append(row_key)
    return failed


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("baseline", help="the 4.x JMH JSON result")
    parser.add_argument("candidate", help="the 5.x JMH JSON result")
    parser.add_argument("--smoke", action="store_true", help="the looser PR smoke rules")
    parser.add_argument("--zero-alloc", default=DEFAULT_ZERO_ALLOC,
                        help="regex of class.method whose throughput rows must allocate nothing")
    parser.add_argument("--startup", default=DEFAULT_STARTUP,
                        help="regex of class.method whose average time is a startup (at most 105%% of 4.x)")
    parser.add_argument("--report", help="also write the report to this file")
    parser.add_argument("--failed", help="write the failed rows to this JSON file")
    parser.add_argument("--warned", help="write the rows that ended as WARN to this JSON file (D44)")
    parser.add_argument("--logs", help="a directory of JMH run logs (*.log, *.failed): a <failure> in a log or a"
                        " .failed (a run that exited with an error) is a harness error")
    parser.add_argument("--rerun", nargs=2, metavar=("BASELINE2", "CANDIDATE2"),
                        help="judge the failed rows again on these re-run results")
    args = parser.parse_args(argv)
    try:
        rerun = (load(args.rerun[0]), load(args.rerun[1])) if args.rerun else None
        warned, harness = [], []
        logs = failures(args.logs) if args.logs else []
        lines, failed, keys = compare(load(args.baseline), load(args.candidate), args.smoke, args.zero_alloc,
                                      args.startup, rerun, warned, harness, logs)
    except (OSError, ValueError, KeyError) as problem:
        print(f"compare: {problem}", file=sys.stderr)
        return 2
    report = "\n".join(lines) + "\n"
    print(report, end="")
    for path, rows in ((args.failed, keys), (args.warned, warned)):
        if path:
            with open(path, "w", encoding="utf-8") as file:
                json.dump([{"benchmark": PREFIX + name, "mode": mode, "threads": threads,
                            "params": dict(item.split("=", 1) for item in params.split(",") if item)}
                           for name, mode, threads, params in rows], file, indent=2)
    if args.report:
        with open(args.report, "w", encoding="utf-8") as file:
            file.write(report)
    if any(line.startswith(f"**{HARNESS}**") for line in lines):
        print(f"compare: {HARNESS}: {len(harness)} rows missing, {len(logs)} JMH failures in the logs; not a result",
              file=sys.stderr)
        return 4
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
